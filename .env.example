# Copy to .env and fill in. Never commit .env.

# Required: reads pages and judges fit. https://console.anthropic.com
ANTHROPIC_API_KEY=

# At least one search provider. Firecrawl is used first when set; TinyFish (free Search/Fetch) is the backup.
FIRECRAWL_API_KEY=
TINYFISH_API_KEY=

# Optional: approve suggestions from your phone. Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
